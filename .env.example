# Database
DATABASE_URL="postgresql://user:password@localhost:5432/coindraft"

# SoSoValue API
SOSOVALUE_API_KEY=your_key_here
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# AI (Groq) — default backend for /api/mentor and /api/breakdown
GROQ_API_KEY=your_key_here

# AI (0G Compute Router) — optional, feature-flagged alternate backend for the
# same two routes. Leave USE_0G_COMPUTE=false (or unset) to stay on Groq.
# Setup requires a wallet-based, manual step at pc.testnet.0g.ai (testnet) or
# pc.0g.ai (mainnet): connect wallet, deposit 0G tokens, generate an sk- key.
# See docs-project/0g-compute-integration-findings.md for the full walkthrough
# and exact testnet/mainnet URLs.
USE_0G_COMPUTE=false
ZG_COMPUTE_API_KEY=sk-your_0g_router_key_here
ZG_COMPUTE_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_COMPUTE_MODEL=your_chosen_model_id_here

# 0G Storage — optional. Permanently records the AI-generated vocab knowledge
# base. Without this, vocab generation still works locally, it just isn't
# archived. A funded 0G testnet wallet's private key — faucet at faucet.0g.ai.
ZG_STORAGE_PRIVATE_KEY=your_testnet_wallet_private_key_here
ZG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# 0G Chain — optional. CoinDraftAchievements (claim-based badge NFTs). Without
# this, the profile page's achievement-claim section simply doesn't render.
# See contracts/ to deploy your own.
ACHIEVEMENTS_CONTRACT_ADDRESS=your_deployed_contract_address_here
ACHIEVEMENTS_RPC_URL=https://evmrpc-testnet.0g.ai

# Auth
SESSION_SECRET=your_random_32_char_secret_key_here

# Reown (public client key)
PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# Vercel Cron auth (set in Vercel project settings; Vercel auto-sends this as a Bearer token to cron routes)
CRON_SECRET=your_random_cron_secret_here

# Email (password-reset style notifications) — optional. A Gmail account with
# an App Password, not your normal login password. Skipped silently if unset.
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here
