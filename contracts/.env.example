# Copy to .env and fill in. Never commit the real .env.

# Deployer/owner wallet for the achievements contract. Can reuse the app's
# ZG_STORAGE_PRIVATE_KEY value, or use a dedicated key — your call.
PRIVATE_KEY=

# Optional overrides — defaults already point at 0G's public testnet/mainnet RPCs.
ZG_CHAIN_RPC_URL_TESTNET=https://evmrpc-testnet.0g.ai
ZG_CHAIN_RPC_URL_MAINNET=https://evmrpc.0g.ai
